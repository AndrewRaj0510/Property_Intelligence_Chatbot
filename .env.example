# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Comma-separated: primary first, then fallbacks. All must be :free and support tool calling.
OPENROUTER_MODELS=
# Embedding model (used at index time and query time)
OPENROUTER_EMBED_MODEL=

# Qdrant Cloud (free cluster)
QDRANT_URL=
QDRANT_API_KEY=

# Langfuse Cloud (Hobby)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Security (optional, recommended in production) ---
# Qdrant Cloud read-only API key used by the running app (the main key above is only needed for ingestion)
QDRANT_READ_API_KEY=
# Secret for HMAC-signing indexed chunks (set the same value at ingestion and runtime); empty = plain SHA-256
INDEX_SIGNING_KEY=
# Per-session rate limit: turns per window
RATE_LIMIT_TURNS=8
RATE_LIMIT_WINDOW_S=60
