# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Comma-separated: primary first, then fallbacks. All must be :free and support tool calling.
OPENROUTER_MODELS=
# Embedding model (used at index time and query time)
OPENROUTER_EMBED_MODEL=

# Qdrant Cloud (free cluster)
QDRANT_URL=
QDRANT_API_KEY=

# Langfuse Cloud (Hobby)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
